# 華流テック通信 by HAL - 環境変数サンプル
# 使い方: cp .env.example .env して値を埋める。.env は git 管理しない (要件 §9.5)。

# ===== Sprint 1A で必須 =====
# Discord 収集サマリーの投稿先 Webhook URL
DISCORD_WEBHOOK_URL=

# エラー通知用の別 Webhook (任意。未指定なら DISCORD_WEBHOOK_URL を使用)
DISCORD_ERROR_WEBHOOK_URL=

# RSSHub セルフホストのベース URL (docker-compose の rsshub サービス)
# sources.yaml の http://localhost:1200/... はこの値で展開する設計 (ADR-0004)
RSSHUB_BASE_URL=http://localhost:1200

# ログレベル (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ===== Sprint 1B 以降 (LLM 編集・台本生成) =====
# Xiaomi MiMo API キー (編集判定候補)
MIMO_API_KEY=
# DeepSeek API キー (台本生成候補)
DEEPSEEK_API_KEY=
# OpenRouter 経由で MiMo/その他を叩く場合 (任意)
OPENROUTER_API_KEY=

# ===== Sprint 2 (音声化 / Kokoro TTS ローカル実行) =====
# Kokoro (ONNX) のモデル本体・voices ファイルのパス (tts/kokoro.py)。
# 未設定時はカレントディレクトリ相対の既定値 (kokoro-v1.0.onnx / voices-v1.0.bin) を探すため、
# `uv run karyu produce --engine kokoro` をそのまま実行すると "not found" で fail-open (無音mp3) しうる。
# 詳細: docs/IMPLEMENTATION_PLAN-2.md T24 運用メモ
KOKORO_MODEL_PATH=~/.cache/karyu-tts/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=~/.cache/karyu-tts/voices-v1.0.bin

# ===== Sprint 2 以降 / 将来 (Cookie 必須ルート) =====
# 知乎タイムライン等の RSSHub ルートが要求する Cookie (当面スコープ外)
ZHIHU_COOKIES=

# ===== Sprint 3 以降 (YouTube 配信) =====
# YouTube Data API OAuth クライアント情報の格納パス等 (将来定義)
# YOUTUBE_CLIENT_SECRETS=

# ===== 任意設定 =====
# HTTP リクエストの User-Agent (FR-014)
USER_AGENT=karyu-tech-news/0.1
# SQLite DB パス (既定 data/state.db)
# DATABASE_PATH=data/state.db
