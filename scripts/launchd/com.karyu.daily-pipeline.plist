<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  華流テック通信 — 日次自動配信 launchd エージェント (T33 で導入 / T44 で恒常運用化)

  collect→draft→produce(Irodori 参照音声)→Discord を平日 (月〜金) 朝 06:30 に 1 回実行する。
  T33 の 3 日限定 (Month+Day ピン) から、恒常運用のため Weekday 方式へ変更。
  Weekday: 1=月 2=火 3=水 4=木 5=金 (0/7=日)。土日は発火しない。

  インストール/アンインストールは scripts/launchd/install.sh / uninstall.sh を使う
  (テンプレート内の __HOME__ プレースホルダを実 $HOME へ展開して ~/Library/LaunchAgents に配置する)。

  ポータビリティ: ProgramArguments は $HOME 経由でユーザー名非依存。ただし launchd は
  StandardOutPath / StandardErrorPath で $HOME を展開しないため、install.sh が実 $HOME に
  置換してから配置する (テンプレートは __HOME__ プレースホルダを持つ)。
  注意: Mac がスリープ中は発火せず、次回 wake 時に catch-up 実行される (launchd は Mac を起こさない)。
        平日朝に確実に配信したい場合は `pmset repeat wakeorpoweron MTWRF 06:25:00` 等で wake を確保する。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.karyu.daily-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/projects/panda-tech-news/scripts/daily_pipeline.sh"</string>
  </array>

  <!-- 平日 (月〜金) 06:30 に発火。各 Weekday を個別 dict で列挙する。 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/projects/panda-tech-news/data/logs/launchd_pipeline.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/projects/panda-tech-news/data/logs/launchd_pipeline.err.log</string>
</dict>
</plist>
