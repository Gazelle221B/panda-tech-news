<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  華流テック通信 — 日次自動配信 launchd エージェント (T33)

  collect→draft→produce(Irodori 参照音声)→Discord を平日朝 06:30 に 1 回実行する。
  StartCalendarInterval を「毎週 Wed/Thu/Fri」ではなく Month+Day で 3 日ぴったりに
  ピン留めし、2026-06-24 / 06-25 / 06-26 の各 06:30 のみ発火 → 以後ドーマント。

  インストール:  cp このファイル ~/Library/LaunchAgents/ && launchctl load それ
  アンインストール: launchctl unload ~/Library/LaunchAgents/com.karyu.daily-pipeline.plist
                    && rm ~/Library/LaunchAgents/com.karyu.daily-pipeline.plist
  注意: Mac がスリープ中は発火せず、次回 wake 時に実行される (launchd は Mac を起こさない)。

  ポータビリティ (Copilot 指摘): ProgramArguments は $HOME 経由でユーザー名非依存にした。
  ただし launchd は StandardOutPath / StandardErrorPath では $HOME を展開しないため絶対パス必須。
  ⚠ 別ユーザー/別配置で使う場合は、下記 StandardOutPath / StandardErrorPath の 2 行と、
  プロジェクトが ~/projects/panda-tech-news 以外にあるなら ProgramArguments のサブパスを編集すること。
-->
<!-- このファイルはテンプレート。現運用中の live copy (~/Library/LaunchAgents) は 6/24-26 の
     実行を安定させるため絶対パス版のまま (起動する daily_pipeline.sh は同一ファイル)。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.karyu.daily-pipeline</string>

  <key>ProgramArguments</key>
  <!-- $HOME でユーザー名をハードコードしない (launchd user agent は $HOME を設定する)。
       スクリプトが自身の位置から PROJECT_DIR を解決し cwd も自分で cd するため WorkingDirectory 不要。 -->
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "$HOME/projects/panda-tech-news/scripts/daily_pipeline.sh"</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Month</key><integer>6</integer>
      <key>Day</key><integer>24</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Month</key><integer>6</integer>
      <key>Day</key><integer>25</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Month</key><integer>6</integer>
      <key>Day</key><integer>26</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/kairyon/projects/panda-tech-news/data/logs/launchd_pipeline.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kairyon/projects/panda-tech-news/data/logs/launchd_pipeline.err.log</string>
</dict>
</plist>
