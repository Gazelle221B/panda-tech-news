# ===== Secrets (要件 §9.5: .env はgit管理しない、.env.example のみ管理) =====
.env
.env.*
!.env.example

# ===== 生成データ / 状態 =====
data/
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
data/episodes/
spike_curl_result.txt
spike_feedparser_result.txt

# ===== 生成アセット (mp3/mp4/wav は外部ストレージ or ローカルのみ) =====
*.mp3
*.mp4
*.wav
*.m4a
# 番組ロゴ・ジングル・BGM の素材本体はコミットしない(配置のみ管理)
assets/jingles/*
assets/bgm/*
assets/voice_reference/*
assets/sfx/*
!assets/**/.gitkeep
!assets/sfx/README.md
# T62 (Issue #65): 採用済み SFX 3種はプロダクトオーナー選定済みの確定素材のためコミットする
# (jingles/bgm/voice_reference と異なり、ライセンス上コミット可能かつ差し替え頻度が低い)。
!assets/sfx/transition.wav
!assets/sfx/opening.wav
!assets/sfx/ending.wav

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.uv_cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ===== OMX / OMC (エージェント一時ファイル) =====
.omc/
.omx/

# ===== OS / エディタ =====
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
.antigravitycli/
